# ==============================================================================
# BloumeID v1.0.0 — Self-Hosted Fingerprinting, Threat Intel & Visitor Identity
# Environment Configuration Template (.env.example)
# Copy this file to `.env` and replace development placeholders before production.
# ==============================================================================

# Master key used to unlock the Admin Console (/login) and sign HttpOnly session cookies.
# Generate a strong 32+ byte secret in production: `openssl rand -base64 48`
ADMIN_MASTER_KEY="bloumeid_dev_master_key_2026"
ADMIN_USERNAME="Jules"

# Optional npm token for publishing @bloume/id locally (`pnpm release:sdk`) or via GitHub Actions (`NPM_TOKEN`)
NPM_TOKEN=""

# PostgreSQL connection string (used by Prisma ORM)
# - For All-in-One Docker Compose (`docker-compose.yml`), keep `bloumeid-db:5432`
# - For External DB (`docker-compose.external-db.yml` / Coolify managed DB), set your external URL
POSTGRES_USER="bloumeid"
POSTGRES_PASSWORD="bloumeid_dev_password"
POSTGRES_DB="bloumeid"
DATABASE_URL="postgresql://bloumeid:bloumeid_dev_password@bloumeid-db:5432/bloumeid?schema=public"

# Redis / Valkey connection URL (used for sliding-window rate limiting, anti-replay nonces, and velocity checks)
REDIS_URL="redis://bloumeid-redis:6379"

# Distributed Snowflake generator worker ID (0 to 1023).
# Set a distinct integer per container replica to prevent Snowflake ID collisions across instances.
WORKER_ID="1"

# Publicly reachable base URL of your BloumeID deployment (no trailing slash).
# Used in integration snippets, CORS defaults, and SDK endpoints.
BLOUMEID_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_BLOUMEID_PUBLIC_URL="http://localhost:3000"

# Trusted reverse-proxy configuration (`true`, `false`, or comma-separated proxy CIDRs).
# When enabled, BloumeID extracts client IPs from `CF-Connecting-IP`, `X-Real-IP`, or `X-Forwarded-For`.
TRUSTED_PROXIES="true"

# Interval in seconds between automatic background threat feed refreshes (X4BNet VPN/Datacenter + Tor Exit List).
FEED_SYNC_INTERVAL="3600"

# Number of days to retain raw FingerprintEvent records before purge.
RETENTION_DAYS="90"

# Directory containing MaxMind GeoLite2 `.mmdb` databases (`GeoLite2-City.mmdb`, `GeoLite2-ASN.mmdb`)
GEOIP_DIR="/app/data/geoip"

# Optional MaxMind License Key for official `.tar.gz` GeoLite2-City & GeoLite2-ASN downloads.
# If left empty, BloumeID automatically falls back to the zero-config open-source mirror (P3TERX/GeoLite.mmdb).
MAXMIND_LICENSE_KEY=""
