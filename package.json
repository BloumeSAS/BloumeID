{
  "name": "bloumeid-monorepo",
  "version": "1.10.43",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @bloume/id build && pnpm --filter @bloumeid/web build",
    "dev": "pnpm --parallel -r dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "release:sdk": "pnpm --filter @bloume/id test && pnpm --filter @bloume/id build && pnpm --filter @bloume/id publish --access public --no-git-checks",
    "bump:version": "node scripts/bump-version.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
